# Copy this file to `.env` and fill in the keys for the providers you use.
# At least one provider key is required.

# OpenAI (default; gpt-* models). Also required for text-embedding-3-small,
# which the memory bank uses for the two-stage retrieval text filter.
OPENAI_API_KEY=

# Google Gemini (gemini-* models). Optional.
# GOOGLE_API_KEY=

# Anthropic Claude (claude-* models). Optional.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=          # optional override
# ANTHROPIC_MAX_TOKENS=8192    # optional
# ANTHROPIC_MAX_RETRIES=10     # optional
